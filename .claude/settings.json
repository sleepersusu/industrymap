{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-build-poll-loop.sh\"",
            "statusMessage": "檢查背景 build 輪詢迴圈"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-i18n-json.sh\"",
            "statusMessage": "檢查 i18n locale JSON 語法與 key 一致性"
          }
        ]
      }
    ]
  }
}
